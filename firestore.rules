rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidSharedList(data) {
      return data.keys().hasOnly(['favorites', 'seen', 'roulette', 'ratings'])
        && (!data.keys().hasAny(['favorites']) || data.favorites is list)
        && (!data.keys().hasAny(['seen'])      || data.seen      is list)
        && (!data.keys().hasAny(['roulette'])  || data.roulette  is list)
        && (!data.keys().hasAny(['ratings'])   || data.ratings   is map);
    }

    match /sharedLists/mainList {
      allow read:   if true;
      allow create: if isValidSharedList(request.resource.data);
      allow update: if isValidSharedList(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
